{% extends 'base.html.twig' %}

{% block title %}Mon Panier - GreenGoodies
{% endblock %}

{% block body %}
	<section class="container my-5 cart-container">
		<h1 class="text-center mb-4">Mon panier</h1>

		{% if orderProducts is empty %}
			<p class="text-center">Votre panier est vide.</p>
		{% else %}
			<div class="text-start mb-3">
				<form method="post" action="{{ path('app_cart_clear') }}" class="d-inline">
					<button type="submit" class="btn btn-link text-decoration-none text-muted p-0">
						<i class="bi bi-x"></i>
						Vider le panier
					</button>
				</form>
			</div>

			{% for item in orderProducts %}
				<div class="card mb-3 border-0 shadow-sm cart-item">
					<div class="row g-0 align-items-center p-3">
						<div class="col-md-3 text-center">
							<img src="{{ asset(item.product.picture) }}" alt="{{ item.product.name }}" class="img-fluid rounded-3">
						</div>
						<div class="col-md-9">
							<div class="card-body">
								<h5 class="card-title fw-bold">{{ item.product.name }}</h5>
								<p class="card-text text-muted mb-1 d-flex align-items-center">
									<span class="me-2">Quantité :</span>

									<!-- Bouton diminuer -->
									<form method="post" action="{{ path('app_cart_remove', {id: item.product.id}) }}" class="d-inline">
										<input type="hidden" name="quantity" value="1">
										<button type="submit" class="btn btn-sm btn-outline-secondary px-2 py-0">–</button>
									</form>

									<span class="mx-2 fw-semibold">{{ item.quantity }}</span>

									<!-- Bouton augmenter -->
									<form method="post" action="{{ path('app_cart_add', {id: item.product.id}) }}" class="d-inline">
										<input type="hidden" name="quantity" value="1">
										<button type="submit" class="btn btn-sm btn-outline-secondary px-2 py-0">+</button>
									</form>
								</p>
								<p class="card-text fw-semibold fs-5">
									{{ (item.price * item.quantity)|number_format(2, ',', ' ') }}
									€
									<span class="text-muted small">
										({{ item.price|number_format(2, ',', ' ') }}
										€ prix unitaire)
									</span>
								</p>
							</div>
						</div>
					</div>
				</div>
			{% endfor %}

			<div class="card border-0 p-3 mt-4 summary-box">
				<div class="d-flex justify-content-between align-items-center mb-2">
					<span class="fw-semibold fs-5">Total panier :</span>
					<span class="fw-bold fs-4">{{ total|default(0)|number_format(2, ',', ' ') }}€</span>
				</div>
				<p class="text-muted mb-0">Frais de livraison : Offert</p>
			</div>

			<div class="text-center mt-4">
				<form method="post" action="{{ path('app_cart_checkout') }}">
					<button type="submit" class="btn btn-dark px-5 py-2 fw-semibold">
						Valider la commande
					</button>
				</form>
			</div>
		{% endif %}
	</section>
{% endblock %}
