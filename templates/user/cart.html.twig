{% extends 'base.html.twig' %}

{% block title %}Mon Panier - GreenGoodies
{% endblock %}

{% block body %}
	<div class="cart-body-bg">
		<div class="cart-container">
			<h1>Mon panier</h1>

			{% if cartProducts is empty %}
				<p class="empty-message">Votre panier est vide.</p>
			{% else %}
				<div class="empty-cart-link">
					<form method="post" action="{{ path('app_cart_clear') }}">
						<button type="submit">x Vider le panier</button>
					</form>
				</div>

				{% for item in cartProducts %}
					<div class="card cart-item">
						<div class="row g-0">
							<div class="col-md-3">
								<img src="{{ asset(item.product.picture) }}" alt="{{ item.product.name }}">
							</div>
							<div class="col-md-9">
								<div class="card-body">
									<h5 class="card-title">{{ item.product.name }}</h5>
									<p class="quantity-text">
										<span>Quantité :</span>
										<div
											class="d-flex align-items-center gap-2">
											<!-- Bouton diminuer -->
											<form method="post" action="{{ path('app_cart_remove', {id: item.product.id}) }}">
												<input type="hidden" name="quantity" value="1">
												<button type="submit" class="btn-quantity">–</button>
											</form>

											<!-- Quantité -->
											<span class="quantity-number">{{ item.quantity }}</span>

											<!-- Bouton augmenter -->
											<form method="post" action="{{ path('app_cart_add', {id: item.product.id}) }}">
												<input type="hidden" name="quantity" value="1">
												<button type="submit" class="btn-quantity">+</button>
											</form>
										</div>
									</p>
									<p class="price-text">{{ (item.price * item.quantity)|format_currency('EUR') }}</p>
								</div>
							</div>
						</div>
					</div>
				{% endfor %}

				<div class="card summary-box">
					<div class="summary-row">
						<span class="summary-label">Total panier :</span>
						<span class="summary-amount">{{ total|default(0)|format_currency('EUR') }}</span>
					</div>
					<p class="shipping-info">Frais de livraison : Offert</p>
				</div>
				<div class="checkout-button-wrapper justify-content-center py-4">
					<form method="post" action="{{ path('app_cart_checkout') }}">
						<button type="submit">Valider la commande</button>
					</form>
				</div>
			{% endif %}
		</div>
	</div>
{% endblock %}
