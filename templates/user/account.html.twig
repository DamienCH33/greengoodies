{% extends 'base.html.twig' %}

{% block title %}Mon compte - GreenGoodies
{% endblock %}

{% block body %}
	<div class="account-body-bg">
		<div class="account-container">
			<h1>Mon compte</h1>

			{# Historique des commandes #}
			<div class="account-section">
				<h5 class="section-title">Mes commandes</h5>

				{% if orders is empty %}
					<p class="empty-orders">Vous n'avez encore passé aucune commande.</p>
				{% else %}
					<table class="orders-table">
						<thead>
							<tr>
								<th>N°</th>
								<th>Date</th>
								<th>Prix</th>
							</tr>
						</thead>
						<tbody>
							{% for order in orders %}
								<tr>
									<td>{{ order.id }}</td>
									<td>{{ order.createdAt|date('d/m/Y') }}</td>
									<td>{{ order.totalPrice|format_currency('EUR') }}</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				{% endif %}
			</div>

			{# Section API Access #}
			<div class="account-section">
				<h5 class="section-title">Mon accès API</h5>
				<form method="post" action="{{ path('app_account_api_access') }}">
					<input type="hidden" name="_token" value="{{ csrf_token('toggle_api_access') }}">
					<button type="submit" class="action-button">
						{% if app.user.apiAccess %}
							Désactiver mon accès API
						{% else %}
							Activer mon accès API
						{% endif %}
					</button>
				</form>
			</div>

			{# Suppression de compte #}
			<div class="account-section">
				<form method="post" action="{{ path('app_account_remove') }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer votre compte ?');">
					<input type="hidden" name="_token" value="{{ csrf_token('delete_account') }}">
					<button type="submit" class="action-button delete-button">
						Supprimer mon compte
					</button>
				</form>
			</div>
		</div>
	</div>
{% endblock %}