{% extends 'base.html.twig' %}

{% block title %}Home - Green Goodies
{% endblock %}

{% block body %}
	<section class="container-fluid section1-welcome">
		<div
			class="row align-items-center">
			<!-- texte -->
			<div class="col-md-6 d-flex flex-column justify-content-center align-items-center text-start">
				<div class="text-start">
					<h1 class="mb-4 my-title-welcome">Bienvenue</h1>

					<p class="mb-4">
						Découvrez notre univers de produits<br>
						durables et éthiques pour une<br>
						consommation responsable.
					</p>

					<p class="mb-4">
						Retrouvez des articles d’hygiène & beauté,<br>
						des accessoires & boissons et du prêt<br>
						à porter.
					</p>
				</div>
			</div>
			<!-- image -->
			<div class="col-md-6 p-0">
				<img src="{{ asset('images/homepage/welcome.jpg') }}" alt="Produits GreenGoodies" class="img-fluid w-100" style="height: 751px; object-fit: cover;">
			</div>
		</div>
	</section>

	<section class="container-fluid section2-categories  align-items-start p-0">
		<div class="row">
			<div class="col-12 text-start mb-4 ">
				<h2 class="my-title mt-4">NOS PRODUITS</h2>
			</div>
		</div>
		<div class="row no-gutters">
			{% for product in products %}
				<div class="col-md-4">
					<div class="card product-card h-100">
						<img src="{{ product.picture }}" alt="{{ product.name }}" class="card-img-top img-fluid">
						<div class="card-body text-center">
							<h5 class="card-title">{{ product.name }}</h5>
							<p class="card-text">{{ product.shortDescription }}</p>
							<p class="card-text">{{ product.price | number_format(2, ',', ' ') }}
								€</p>
							<a href="{{ path('app_product_detail', {'id': product.id}) }}" class="nav-link">Voir le produit</a>
						</div>
					</div>
				</div>
			{% endfor %}
		</div>
	</section>

	<section class="container-fluid section3">
		<div class="row align-items-center">
			<!-- texte -->
			<div class="col-md-8 d-flex flex-column ps-5">
				<h1 class="my-title-conviction">NOTRE CONVICTION</h1>

				<p class="mb-4 text-left text-conviction">
					Chez GreenGoodies, nous croyons en un monde où le commerce
					<br>
					peut être synonyme de bien-être pour la planète et ses
					<br>
					habitants. Notre mission est de vous proposer une sélection
					<br>
					rigoureuse de produits qui allient qualité, durabilité et éthique
				</p>
			</div>
			<!-- image -->
			<div class="col-md-4 p-0">
				<img src="{{ asset('images/homepage/login.jpg') }}" alt="Produits GreenGoodies" class="img-fluid w-100" style="height: 751px; object-fit: cover;">
			</div>
		</div>
	</section>

	<section class="container-fluid section4">
		<div
			class="row align-items-center">
			<!-- image -->
			<div class="col-md-4 p-0">
				<img src="{{ asset('images/homepage/homepage.jpg') }}" alt="Produits GreenGoodies" class="img-fluid w-100" style="height: 751px; object-fit: cover;">
			</div>
			<!-- texte -->
			<div class="col-md-8  d-flex flex-column  align-items-end pe-5 pb-5">
				<h1 class="my-title-conviction">NOS VALEURS</h1>

				<p class=" text-left text-conviction">
					Durabilité : Nous sélectionnons soigneusement des produits qui
					<br>
					respectent l'environnement et favorisent la durabilité.<br>
					Éthique : Nous nous engageons à travailler avec des partenaires et des
					<br>
					fournisseurs qui partagent nos valeurs éthiques.<br>
					Écologie : Nous encourageons des pratiques respectueuses de
					<br>
					l'écosystème et privilégions les matériaux écologiques.
				</p>
			</div>
		</div>
	</section>
{% endblock %}
