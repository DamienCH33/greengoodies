{% extends 'base.html.twig' %}

{% block title %}Home - Green Goodies
{% endblock %}

{% block body %}
	<section class="container-fluid section1-welcome">
		<div
			class="row align-items-center">
			<!-- texte -->
			<div class="col-md-6 d-flex flex-column justify-content-center align-items-center text-start">
				<div class="text-start">
					<h1 class="mb-4 my-title-welcome">Bienvenue</h1>

					<p class="mb-4">
						Découvrez notre univers de produits<br>
						durables et éthiques pour une<br>
						consommation responsable.
					</p>

					<p class="mb-4">
						Retrouvez des articles d’hygiène & beauté,<br>
						des accessoires & boissons et du prêt<br>
						à porter.
					</p>
				</div>
			</div>
			<!-- image -->
			<div class="col-md-6 p-0">
				<img src="{{ asset('images/homepage/welcome.jpg') }}" alt="Produits GreenGoodies" class="img-fluid w-100" style="height: 751px; object-fit: cover;">
			</div>
		</div>
	</section>

	<section class="container-fluid section2-categories  align-items-start p-0">
		<div class="products-body-bg">
		<div class="products-container">
			<h2 class="products-title">NOS PRODUITS</h2>

			<div class="products-grid">
				{% for product in products %}
					<div class="product-card">
						<img src="{{ product.picture }}" alt="{{ product.name }}" class="product-image">
						<div class="product-info">
							<h5 class="product-name">{{ product.name }}</h5>
							<p class="product-description">{{ product.shortDescription }}</p>
							<p class="product-price">{{ product.price|format_currency('EUR') }}</p>
							<a href="{{ path('app_product_detail', {'id': product.id}) }}" class="product-link">Voir le produit</a>
						</div>
					</div>
				{% else %}
					<p class="no-products">Aucun produit disponible pour le moment.</p>
				{% endfor %}
			</div>
		</div>
	</div>
	</section>
	<!-- Section Notre Conviction -->
	<section class="conviction-section">
		<div class="conviction-text">
			<h2 class="section-title">NOTRE CONVICTION</h2>
			<p class="section-description">
				Chez GreenGoodies, nous croyons en un monde où le commerce<br>
				peut être synonyme de bien-être pour la planète et ses<br>
				habitants. Notre mission est de vous proposer une sélection<br>
				rigoureuse de produits qui allient qualité, durabilité et éthique
			</p>
		</div>
		<div class="conviction-image">
			<img src="{{ asset('images/homepage/login.jpg') }}" alt="Produits GreenGoodies">
		</div>
	</section>

	<!-- Section Nos Valeurs -->
	<section class="values-section">
		<div class="values-image">
			<img src="{{ asset('images/homepage/homepage.jpg') }}" alt="Produits GreenGoodies">
		</div>
		<div class="values-text">
			<h2 class="section-title">NOS VALEURS</h2>
			<p class="section-description">
				Durabilité : Nous sélectionnons soigneusement des produits qui<br>
				respectent l'environnement et favorisent la durabilité.<br>
				Éthique : Nous nous engageons à travailler avec des partenaires et des<br>
				fournisseurs qui partagent nos valeurs éthiques.<br>
				Écologie : Nous encourageons des pratiques respectueuses de<br>
				l'écosystème et privilégions les matériaux écologiques.
			</p>
		</div>
	</section>
{% endblock %}
