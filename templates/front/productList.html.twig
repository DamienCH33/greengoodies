{% extends 'base.html.twig' %}

{% block title %}
	Nos produits - Green Goodies
{% endblock %}

{% block body %}
	<section class="container-fluid section2-categories my-5 align-items-start p-0">
		<div class="row">
			<div class="col-12 text-start mb-4 ">
				<h2 class="my-title">NOS PRODUITS</h2>
			</div>
		</div>
		<div class="row no-gutters">
			{% for product in products %}
				<div class="col-md-4">
					<div class="card product-card h-100">
						<img src="{{ product.picture }}" alt="{{ product.name }}" class="card-img-top img-fluid">
						<div class="card-body text-center">
							<h5 class="card-title">{{ product.name }}</h5>
							<p class="card-text">{{ product.shortDescription }}</p>
							<p class="card-text">{{ product.price | number_format(2, ',', ' ') }}
								€</p>
							<a href="{{ path('app_product_detail', {'id': product.id}) }}" class="nav-link">Voir le produit</a>
						</div>
					</div>
				</div>
			{% else %}
				<p class="text-center">Aucun produit disponible pour le moment.</p>
			{% endfor %}
		</div>
	</section>
{% endblock %}
