{% extends 'base.html.twig' %}

{% block title %}Connexion - Green Goodies
{% endblock %}

{% block body %}
<section class="container-fluid section-login">
    <div class="row align-items-stretch">
        <!-- Image à gauche -->
        <div class="col-md-6 p-0">
            <img src="{{ asset('images/homepage/login.jpg') }}" alt="GreenGoodies"
                 class="img-fluid w-100" style="height: 1104px; object-fit: cover;">
        </div>

        <!-- Formulaire à droite -->
        <div class="col-md-6 d-flex flex-column justify-content-center align-items-start px-5 py-5">
            <h2 class="text-dark mb-4">Connexion</h2>

            <form method="post" action="{{ path('app_login') }}" class="w-100" style="max-width: 480px;">

                {% if error %}
                    <div class="alert alert-danger text-center mb-3">
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                <div class="mb-3">
                    <label for="inputEmail" class="form-label fw-normal">Adresse email</label>
                    <input type="email" id="inputEmail" name="_username"
                           class="form-control border-dark-subtle rounded-0 py-3"
                           value="{{ last_username }}" required autofocus>
                </div>

                <div class="mb-4">
                    <label for="inputPassword" class="form-label fw-normal">Mot de passe</label>
                    <input type="password" id="inputPassword" name="_password"
                           class="form-control border-dark-subtle rounded-0 py-3" required>
                </div>

                <button type="submit" class="btn btn-dark w-100 py-3 rounded-0">Se connecter</button>

                <p class="text-center mt-3 mb-0">
                    Pas encore de compte ?
                    <a href="{{ path('app_register') }}" class="text-dark text-decoration-none">S’inscrire</a>
                </p>
            </form>
        </div>
    </div>
</section>
{% endblock %}
